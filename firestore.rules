rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }


    // 1. Users collection: users can only read & update their own record
    // Client cannot tamper with privileged fields: accountStatus, isAdmin, roles, subscriptionTier
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) &&
        !request.resource.data.keys().hasAny(['isAdmin', 'roles']) &&
        request.resource.data.accountStatus in ['active', 'pending'];
      allow update: if isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountStatus', 'isAdmin', 'roles', 'subscriptionTier']);
      allow delete: if isOwner(uid);
    }

    // 2. Candidate Profiles: isolated per user
    match /profiles/{uid} {
      allow read, write: if isOwner(uid);
    }

    // 3. Resumes metadata: owner-scoped
    match /resumes/{resumeId} {
      allow read, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid);
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid) && (request.resource.data.userId == request.auth.uid);
    }

    // 4. Jobs: Publicly readable; strictly read-only for normal users
    match /jobs/{jobId} {
      allow read: if true;
      allow write: if false; // Only manageable by admin / backend cloud functions
    }

    // 5. Job Matches: user-scoped
    match /jobMatches/{matchId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid);
      allow create, update, delete: if false; // Generated by matching engine
    }

    // 6. Applications: user-scoped application tracking
    // Server-controlled fields (verifiedSubmission, systemStatus) cannot be altered by client
    match /applications/{applicationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid);
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid) && (request.resource.data.userId == request.auth.uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verifiedSubmission', 'systemStatus']);
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid);
    }

    // 7. Automation Settings: user-scoped configuration
    match /automationSettings/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) &&
        request.resource.data.dailyLimit is number &&
        request.resource.data.dailyLimit <= 50 &&
        request.resource.data.minimumMatchScore >= 0 &&
        request.resource.data.minimumMatchScore <= 100;
      allow delete: if isOwner(uid);
    }

    // 8. Automation Logs: read-only for user, creation scoped to user's actions
    match /automationLogs/{logId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid);
      allow update, delete: if false;
    }

    // 9. Notifications: private per user
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid);
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid);
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid);
    }

    // 10. Subscriptions: read-only for user
    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid);
      allow write: if false; // Payment webhook / server only
    }

    // Default deny for anything unspecified
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
